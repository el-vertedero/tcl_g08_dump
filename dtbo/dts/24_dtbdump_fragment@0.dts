/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			android {

				vbmeta {
					compatible = "android,vbmeta";
					parts = "vbmeta,boot,system,vendor,oem,bootdata,tvconfig";
					by_name_prefix = "/dev/block/platform/mstar_mci.0/by-name/vbmeta";
				};
			};
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			ini_path = "audio/";
			pre_init_table = "audio_pre_init_mt5879.ini";
			init_table = "audio_init_mt5879.ini";
			depop_table = "depop_mt5879.ini";
			earc_table = "earc_mt5879.ini";
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			rx-desc-num = <0x200>;
			ethpll-ictrl = <0x01>;
			mac-type = <0x01>;
			phy-process = <0x01>;
			threaded-irq = <0x01>;
			irq-affinity = <0x03>;
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			phys = <0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x04>;
			mediatek,phy_mixed_mode;
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {
			phys = <0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x03 0xffffffff 0x04>;
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {
			reg = <0x00 0x1c790060 0x00 0x08 0x00 0x1c790260 0x00 0x08>;
			reg-names = "i2c_ctrl_reg\0i2c_ctrl_reg_u2";
			mediatek,phy_2nd_i2c;
			mediatek,phy_mixed_mode;
			mediatek,src_hw_capable;

			usb-phy@1C780000 {
				reg = <0x00 0x1c780000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C781000 {
				reg = <0x00 0x1c781000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C782000 {
				reg = <0x00 0x1c782000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C780700 {
				reg = <0x00 0x1c780700 0x00 0x900 0x00 0x1c2c6c00 0x00 0x800 0x00 0x1c201100 0x00 0x08 0x00 0x1c770000 0x00 0x10000>;
				#phy-cells = <0x01>;
				degradation-mode = <0x02>;
				status = "okay";
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {
			phys = <0xffffffff 0x03 0xffffffff 0x04>;
			mediatek,phy_mixed_mode;
			reg = <0x00 0x1c1b3e00 0x00 0x100 0x00 0x1c1b1000 0x00 0x2800>;
			reg-names = "ippc\0mac";
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {
			mediatek,phy_mixed_mode;
			mediatek,src_hw_capable;

			usb-phy@1C1A0000 {
				reg = <0x00 0x1c1a0000 0x00 0x700>;
				#phy-cells = <0x01>;
				status = "okay";
			};

			usb-phy@1C1A0700 {
				reg = <0x00 0x1c1a0700 0x00 0x900 0x00 0x1c0a0200 0x00 0x800 0x00 0x1c0a0000 0x00 0x08 0x00 0x1c1f0000 0x00 0x10000>;
				#phy-cells = <0x01>;
				degradation-mode = <0x02>;
				status = "okay";
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			usb2-lpm-disable;
			irq-affinity = <0x03>;
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {
