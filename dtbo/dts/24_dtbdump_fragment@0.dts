			ngpios = <0x68>;
			base = <0x12c>;
			max-ngpios = <0xc8>;
			irq-both-edge = <0x01>;
			reg = <0x00 0x1c023000 0x00 0x200 0x00 0x1c022e00 0x00 0x200 0x00 0x1c023200 0x00 0x200>;
			hwlocks = <0xffffffff 0x00>;
			status = "okay";
