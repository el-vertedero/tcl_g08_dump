# FILE:-logkit.rc
# Description:
#    Define new service by init
# xing28.wang@tcl.com, 2021/09/23, add for log tool
on post-fs-data
    mkdir /data/tcl_log 0770 root system
    mkdir /data/tcl_log/tmp 0770 root system
    restorecon --recursive /data/tcl_log
    setprop persist.sys.logkitversion 300239994163729
service GeorgedebugStartCollectBootMainLog /system/bin/sh /system_ext/bin/logkit.sh "CollectBootMainLog"
  class core
  user root
  group root system
  seclabel u:r:logkit_service:s0
  disabled
  oneshot

