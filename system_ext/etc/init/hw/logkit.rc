on property:persist.sys.perfettolog=true
    start GeorgedebugInitPerfettoAsyncLog
on property:persist.sys.perfettolog=false
    start GeorgedebugPerfettoAsyncStop
    setprop persist.sys.perfettolog "-1"

on property:persist.sys.anrtrace=true
    start InitAnrPerfettoAsyncLogService
on property:persist.sys.anrtrace=false
    start StopAnrPerfettoLogService
on property:persist.sys.anrtrace.state="copy"
    start MvAnrPerfettoLogService

on property:persist.sys.stoplog=true
    start GeorgedebugStopLog
    setprop persist.sys.stoplog "-1"
on property:sys.dumpscreenrecord.start=true
      start GeorgedebugScreenRecordAndDump
on property:sys.dumpaudio.start=true
      start GeorgedebugDumpAudio

# Deprecated: usblog trigger moved to userlogkit.rc
#on property:persist.sys.usblog=true
#start GeorgedebugUsbInitLog

on property:sys.bugreport.start=true
start GeorgedebugLogcatBugreportForNvr

# Deprecated: usblog trigger moved to userlogkit.rc
#on property:sys.boot_completed="1" && property:persist.sys.usblog=false
# stop GeorgedebugUsbLogcatMain
# stop GeorgedebugUsbLogcatEvent
# stop GeorgedebugUsbLogcatKernel
# stop GeorgedebugUsbWatchLogcat

on property:sys.dumpSystem.start=true
  start dumpSystem

on property:persist.sys.normallog=true
  start GeorgedebugInitBootLog
  start GeorgedebugInitLog

on property:persist.sys.normallog=false
  stop GeorgedebugInitBootLog
  stop GeorgedebugInitLog

on property:sys.collectbootlog.start=true
  start GeorgedebugStartCollectBootMainLog
  start GeorgedebugStartCollectBootEventLog
  start GeorgedebugStartCollectBootKernelLog

on property:sys.collectbootlog.start=false
  stop GeorgedebugStartCollectBootMainLog
  stop GeorgedebugStartCollectBootEventLog
  stop GeorgedebugStartCollectBootKernelLog

on property:sys.perfettostart.start=true
  start GeorgedebugPerfettoStart

on property:sys.mvperfettostart.start=true
  start mvPerfetto


