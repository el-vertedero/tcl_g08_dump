service UserInputPerformanceLogService  /system/bin/sh /system_ext/bin/userlogkit.sh "UserInputPerformanceLog"
    class core
    user root
    group system root sdcard_rw everybody
    seclabel u:r:logkit_service:s0
    disabled
    oneshot

service StartUserInputPerformanceLogService /system/bin/sh /system_ext/bin/userlogkit.sh "StartUserInputPerformanceLog"
    class core
    user  system
    group misc shell root everybody
    seclabel u:r:shell:s0
    disabled
    oneshot

service UserMvInputPerformanceLogService /system/bin/sh /system_ext/bin/userlogkit.sh "UserMvInputPerformanceLog"
    class core
    user system
    group misc root everybody system sdcard_rw
    seclabel u:r:adbd:s0
    disabled
    oneshot

service StopAndTarLogService  /system/bin/sh /system_ext/bin/userlogkit.sh "StopAndTarLog"
    class core
    user root
    group system root sdcard_rw everybody
    seclabel u:r:logkit_service:s0
    disabled
    oneshot

on property:persist.sys.userlog_inputperformance_service=true
    start UserInputPerformanceLogService

on property:persist.sys.userlog_delete_all=true
    start UserDeleteAllLogService

on property:persist.sys.userlog=true
    start UserLogService

on property:persist.sys.userlog=false && property:persist.sys.userlogstatus="running"
    start StopAndTarLogService

on property:persist.sys.userlog=false && property:persist.sys.userlogstatus="err_2"
    start StopAndTarLogService

on property:persist.sys.userlog=false && property:persist.sys.userlogstatus="prepackaging"
    start StopAndTarLogService

on property:persist.sys.userlog=false && property:persist.sys.userlogstatus="packaging"
    start StopAndTarLogService
