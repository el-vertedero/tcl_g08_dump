#
# FILE:-userlogkit.rc
# Description:
#    Define new service by init
# ziqian1.liu@tcl.com, 2023/04/21, add for log tool
on post-fs-data
    mkdir /data/user_log 0755 root system
    restorecon --recursive /data/user_log

service UserLogService  /system/bin/sh /system_ext/bin/userlogkit.sh "UserLog"
    class core
    user root
    group system root sdcard_rw everybody
    seclabel u:r:logkit_service:s0
    disabled
    oneshot

service UserDetectStorageService  /system/bin/sh /system_ext/bin/userlogkit.sh "UserDetectStorage"
    class core
    user root
    group system root sdcard_rw everybody
    seclabel u:r:logkit_service:s0
    disabled
    oneshot

