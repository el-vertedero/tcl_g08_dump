
service aiod /system_ext/bin/aiod
    class early_hal
    user root
    group root
    critical
    seclabel u:r:aiod:s0

on property:persist.sys.first_boot=1
    mkdir /data/system/fcm 0777 system system
    write /data/system/fcm/component_version.txt ""
    chown system system /data/system/fcm/component_version.txt
    chmod 0666 /data/system/fcm/component_version.txt
    write /data/system/fcm/component_version.txt.fallback ""
    chown system system /data/system/fcm/component_version.txt.fallback
    chmod 0666 /data/system/fcm/component_version.txt.fallback
    write /data/system/fcm/feature_config.pb ""
    chown system system /data/system/fcm/feature_config.pb
    chmod 0666 /data/system/fcm/feature_config.pb
    write /data/system/fcm/feature_config.pb.fallback ""
    chown system system /data/system/fcm/feature_config.pb.fallback
    chmod 0666 /data/system/fcm/feature_config.pb.fallback
    restorecon -r -v /data/system/fcm
