import /vendor/etc/init/init.fusion.rc

on fs
    # insert tee driver
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      optee.ko mtk_tee.ko

    # /proc/efuse is created by mtk-efuse.ko; if move mtk-efuse.ko, should also move "chown root system /proc/efuse"
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mtk-ab-boot.ko mtk-efuse.ko
    chown root system /proc/efuse


on early-boot
   # insert GKI modules
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      cfg80211.ko mac80211.ko

   # insert memory related drivers
   exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      ion_cma_heap.ko system_heap.ko mtk_iommu.ko

   ## yuwei1.wang@tcl.com [LINTHYOSU-1290] 2025/5/28, add usb0 net ko for com.tcl.eva
   # insert GKI modules for usb camera
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
       r8152.ko usbnet.ko aqc111.ko cdc_ether.ko ax88179_178a.ko

   # insert audio related drivers
   exec u:r:setup_audio_offload:s0 -- /vendor/bin/sh /vendor/bin/setup_audio_offload.sh

   # insert peripheral drivers
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mt5896-mailbox.ko mt5896_hwspinlock.ko wdt-mt5896.ko mtk-bdma.ko \
      rtc-mt5896.ko mt5896_saradc.ko virtio_rpmsg_bus.ko mtk_pmu_rproc.ko \
      pwm-mt5896.ko pwmscan-mt5896.ko pwm-mtk-pmu.ko pwm_bl.ko i2c-mt5896.ko i2c-gpio.ko \
      pwmadc-mt5896.ko pwmseg-mtktv.ko i2c-dev.ko spidev.ko leds-mtk-irtx.ko leds-gpio.ko leds-breath.ko gpio-mtk-pmu.ko \
      keypad-mt5896.ko mtk-ir.ko i2c-mt5896-rproc.ko mtk_mic_mute_drv.ko mtk_frc_mcu_rproc.ko \
      ws_tsf.ko

    # need block run insmod audio driver ko, avoid card num change issue.
    exec u:r:setup_audio_ko:s0 -- /vendor/bin/sh /vendor/bin/setup_audio_ko.sh

    #insert realtime module in the following order
    insmod /vendor/lib/modules/mtk_realtime_producer.ko
    start realtime-svc

    ## ifdef VENDOR_EDIT
    ## zhipeng5.wei@tcl.com 2023/01/05 add for vrr tcl vdf
    insmod /vendor/lib/modules/tcl_vdf.ko
    ## endif VENDOR EDIT
    #insert tcl dcl ko
    insmod /vendor/lib/modules/tdlc.ko

    # insert display driver
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mtk_hwreg.ko mtk-pqmaputil.ko mtk_xcalg.ko mtk_xcalg3pty.ko mtk_xcalg3pty_hdrvivid.ko  mtk_cus.ko \
      vim2m.ko  mtk_pqu_rproc.ko mtktv-disp-rm.ko mtk_shmctrl.ko \
      mtk-stctrl.ko mtk-caps.ko mtk-pq.ko mtk-srccap.ko spi-mtk-pmu.ko  mtk-pmu-ir.ko btmtk_pmu.ko

    #google issue #419909704 /data/vendor/mediadrm must be created before mediatek-drm-tv.ko is insmodded.
    mkdir /data/vendor/mediadrm 0770 media mediadrm
 
    #insert atsc3 driver
    start  pre_insert_module

    #insert vcodec / drm driver
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mtk-vcu-vdec.ko mtk-vcu-venc.ko mtk-vcodec-dec.ko mtk-vcodec-enc.ko \
      mtk-v4l2-jpd.ko mediatek-drm-tv.ko

    # sync mode for fence
    chmod 666 /sys/kernel/debug/sync/sw_sync

    # insert apu_comm apusys mdla (AI)
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mtktv_apusys.ko apu_power.ko mdla.ko edma.ko

    # insert dvb / cfm / dmx driver
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules	\
      mtk_dmx.ko

    # insert EARC driver
    insmod /vendor/lib/modules/mtk-earc.ko
    # insert pnl_cust pmic driver
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      pnl_cust.ko

    # OverScan/Pq configuration
    chmod 666 /mnt/vendor/persist/app/tv_overscan.json
    chmod 666 /mnt/vendor/persist/app/tv_picture_setting_default_values.json

    # insert tuner / dish /dscmb / cec / demod driver
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      tuner_mxl661.ko tuner_av2017.ko tuner_rt710.ko dish_rt5047.ko dish_rt5047_bf.ko dish_sgm41286.ko tuner_r842.ko \
      dish_h29.ko dish_h30.ko dish_tps65235.ko dish_tps65233.ko dish_arg81300.ko \
      mtk-cec.ko mtk-austin-demod.ko mtk-merak20-demod.ko

    # insert Mali driver
    insmod /vendor/lib/modules/mali_kbase_${ro.boot.vendor.cf.hardware}.ko

    # insert voice driver
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mtk-mic-capture.ko

    # insert dvfs driver early
    start early_insert_dvfs

    # insert dramc mediator driver
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mtktv-dramc.ko mtk-mediator.ko

    #insert audio driver (can't use modprobe)
    insmod /vendor/lib/modules/extcon-mtk-headset.ko
    insmod /vendor/lib/modules/snd-aloop.ko
    insmod /vendor/lib/modules/mtk-aloop.ko
    insmod /vendor/lib/modules/mtk-pmu-ir.ko
    insmod /vendor/lib/modules/btmtk_pmu.ko

    # insert es buffer mgr for SVP, this ko do not depends on other ko.
    insmod /vendor/lib/modules/mtk-es-buf-mgr.ko

    ## yuwei1.wang@tcl.com [LINTHYOSU-1290] 2025/5/28, add usb0 net ko for com.tcl.eva
    #for usb camera
    insmod /vendor/lib/modules/mtktv-vendor-hook.ko
    insmod /vendor/lib/modules/rndis_host.ko

    # insert light sensor driver
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor/lib/modules \
      mtk_als.ko mtk_light.ko

    # insert ntfs R/O driver
    insmod /vendor/lib/modules/ntfs.ko

    # inser debug ko
on early-boot && property:ro.boot.stress=on && property:ro.debuggable=1
    insmod /vendor/lib/modules/mtk-hang-debug.ko
    insmod /vendor/lib/modules/mtk-xiu-timeout.ko
    insmod /vendor/lib/modules/mtk-hwwp.ko
    insmod /vendor/lib/modules/mtk-mmdebug.ko
    insmod /vendor/lib/modules/mtk-irqmon.ko
    insmod /vendor/lib/modules/mtk-riu-prot.ko

on property:ro.boot.strtest=on && property:ro.debuggable=1
    write /dev/kmsg "<3>----- ro.boot.strtest=on -----"
    write /sys/module/mtk_hwwp/parameters/debug_suspend 1
    write /sys/power/pm_debug_messages 1

on early-boot && property:ro.vendor.mtk.ltpktf=true
    insmod /vendor/lib/modules/ktf.ko
    insmod /vendor/lib/modules/mtk-v4l2-g2d.ko

on early-boot && property:ro.vendor.mtk.tfafuzzer=true
    insmod /vendor/lib/modules/atf_fuzzer.ko

on property:vendor.mtk.audio_ko=1
    start cpu-audio

on property:sys.boot_completed=1
    start post_insert_module
    start startdelegate-hal-1-0
    start post_insert_dvfs

    # post insert kernel driver
service post_insert_module /vendor/bin/sh /vendor/bin/insert_kernel_drv.sh
    console
    oneshot
    seclabel u:r:mt_insert_kernel_drv:s0

    # early insert dvfs driver
service early_insert_dvfs /vendor/bin/sh /vendor/bin/insert_dvfs_drv.sh early-boot
    console
    oneshot
    seclabel u:r:mt_insert_kernel_drv:s0

    # post insert dvfs driver
service post_insert_dvfs /vendor/bin/sh /vendor/bin/insert_dvfs_drv.sh
    console
    oneshot
    seclabel u:r:mt_insert_kernel_drv:s0

    # wlan dongle detect service
service wlan_dongle_detect /vendor/bin/wlan_dongle_detect
    class main
    priority 19
    ioprio idle 7
    console
    oneshot
    seclabel u:r:mt_wlan_dongle_detect:s0

    # post insert kernel driver
service pre_insert_module /vendor/bin/sh /vendor/bin/insert_atsc3_drv.sh
    console
    oneshot
    seclabel u:r:mt_insert_kernel_drv:s0
