# ifdef VENDOR_EDIT
# jiehua2.li@tcl.com, 2024/05/13, add for kfault kernel init timeout
on init
    write /proc/kfaultfs_uboot stopwdg
# endif /* VENDOR_EDIT */

on post-fs
#    setprop ro.product.name ${ro.vendor.build.fingerprint}
#    setprop ro.vendor.product.cpu.abilist       ${ro.product.cpu.abilist}
#    setprop ro.vendor.product.cpu.abilist32     ${ro.product.cpu.abilist32}
#    setprop ro.vendor.product.cpu.abilist62     ${ro.product.cpu.abilist64}

# ifndef VENDOR_EDIT
# kaixuan.ning@tcl.com, 2022/09/13, modify for dynamic fingerprint
    setprop ro.product.vendor.device            ${ro.boot.device_name}
#[SYSD SYS] Modified manufacturer source by yangao.chen for T8868855 on 2020-02-11
    setprop ro.product.vendor.manufacturer      ${ro.boot.manufacturer}
    setprop ro.product.vendor.model             ${ro.boot.model_name}
    setprop ro.product.vendor.name              ${ro.boot.product_name}
# Write attestation specific properties
    setprop ro.product.model_for_attestation           ${ro.boot.model_name}
    setprop ro.product.name_for_attestation            ${ro.boot.product_name}
    setprop ro.product.device_for_attestation          ${ro.boot.device_name}
    setprop ro.product.manufacturer_for_attestation    ${ro.boot.manufacturer}
# ifndef VENDOR_EDIT
# yulong8.zhang@tcl.com, 2023/3/2, modify brand to tcl_brand for FCM
    setprop ro.vendor.build.fingerprint         ${ro.product.vendor.brand:-unknown}/${ro.boot.product_name:-unknown}/${ro.boot.device_name:-unknown}:${ro.vendor.build.version.release_or_codename:-unknown}/${ro.vendor.build.id:-unknown}/${ro.boot.code_name:-unknown}:${ro.vendor.build.type:-unknown}/${ro.vendor.build.tags:-unknown}
    setprop ro.odm.build.fingerprint            ${ro.product.odm.brand:-unknown}/${ro.boot.product_name:-unknown}/${ro.boot.device_name:-unknown}:${ro.vendor.build.version.release_or_codename:-unknown}/${ro.vendor.build.id:-unknown}/${ro.boot.code_name:-unknown}:${ro.vendor.build.type:-unknown}/${ro.vendor.build.tags:-unknown}
# endif /* VENDOR_EDIT */
# endif /* VENDOR_EDIT */
