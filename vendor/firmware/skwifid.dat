%firmware% 

#It's time for Sta trigger disconnect when no frame exchanged with Ap, Unit=1s

[link_loss_thrd]=<6>

#GO MCC schedule
#force_go_once_noa=<En>,<GoPresentTime>,<GoAbsentTime>

#En=0: default, GO use period NOA (interval=102400us) when MCC
#En=1: GO use ONCE NOA when MCC
#	GoPresentTime/GoAbsentTime: Fix Go Present/Absent Time By Host when En=1, Value=(1,10), Unit=102ms
#	GoPresentTime: for P2P
#	GoAbsentTime: for Sta or Others

[force_go_once_noa]=<0>,<0>,<0>

#Fix Go Noa Ratio when MCC
#go_noa_ratio_idx=<En>,<Idx>

#En=0: disable, use default 
#	STA Idle + P2P Idle： 1 ：1
#	STA Busy + P2P Idle:  3 : 1
#	STA Idle + P2p Busy： 1 ：3
#	STA Busy + P2P Busy:  1 : 1

#En=1: enable, use fix Ratio Idx
#	Fixed Go Noa Ratio when MCC
#	Idx		P2P(period NOA/Once NOA ms)	 STA(period NOA/Once NOA ms)
#	0  		51/2*102					 51/2*102
#	1		25/1*102					 77/3*102
#	2		77/3*102					 25/1*102
#	3		85/5*102					 17/1*102

[go_noa_ratio_idx]=<1>,<3>

#24ghz_bandwidth=<bandwidth>
#bandwidth=1: 40M
#bandwidth=0: 20M
[24ghz_bandwidth]=<1>

%wowlan_config%
[wowlan_support]=<1>
[wowlan_enable]=<0>
[wowlan_advpws]=<0>
