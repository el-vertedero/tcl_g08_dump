						log_info "$(/vendor/bin/ip route | grep "240.1.0.0/16" | awk '{print $1}')"
						
					fi

					if [ "$(/vendor/bin/ip route | grep "240.1.0.0/16" | awk '{print $NF}')" == "240.1.1.100" ];then
						break
					else
						/vendor/bin/ip -4 addr add 240.1.1.100/16 dev eth1
						log_info "config 240.1.0.0/16 again"
						log_info "$(/vendor/bin/ip route | grep "240.1.0.0/16" | awk '{print $1}')"
						log_info "$(/vendor/bin/upgrade_tool -v -s 0 -f 1 -i 1 | grep "ver" | cut -d ":" -sf 2)"
						log_info "$(/vendor/bin/upgrade_tool -v -s 0 -f 2 -i 0 | grep "ver" | cut -d ":" -sf 2)"
						log_info "$(/vendor/bin/upgrade_tool -v -s 0 -f 3 -i 0 | grep "ver" | cut -d ":" -sf 2)"
						
					fi

				done 
				log_info ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>end "
			fi

			log_info "config end"
			log_info ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>"
			log_info "$(/vendor/bin/ip rule | grep "22000:")"
			log_info "$(/vendor/bin/ip route | grep "240.1.0.0/16")"
			log_info "$(/vendor/bin/ip rule | grep "240.1.1.1")" 
			log_info ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>right and end "
			break
		else 
			break
		fi
	done
	/vendor/bin/ip -4 addr add 240.1.1.100/16 dev eth1
fi

##################################################################################################################################
#第一阶段，upgrade模块启动
#脚本依赖：upgrade模块的返回值
#        如果返回0：正常启动无升级动作
#   		   99: 有升级动作升级成功
#              -1：获取当前器件版本失败
#              -2：获取升级后器件版本失败
#              -3：MCU复位失败
#			   -4：MCU升级失败
#			   -5：FPGA升级失败
#			   -6：GOLDEN升级失败
log_info ">>>>>>>>>>>>>>>>>>>>start upgrade: "
#sleep 1
MCU_CURRENT_VER=$(/vendor/bin/upgrade_tool -v -s 0 -f 1 -i 1 | grep "ver" | cut -d ":" -sf 2)
FPGA_CURRENT_VER=$(/vendor/bin/upgrade_tool -v -s 0 -f 2 -i 0 | grep "ver" | cut -d ":" -sf 2)

#网络未准备好
if [ "$MCU_CURRENT_VER" = " " ] && [ "$FPGA_CURRENT_VER" = " " ]; then
	log_info "the network not connect, don't upgrade"
else
	$upgrade_defpath $mcu_defpath $fpga_defpath $bin_path
	upgradeStatus=$?
	updateSign=NotUpdate
	log_info "upgrade return $upgradeStatus"


	if [ $upgradeStatus -eq 99  ]; then #升级成功
		log_info ">>>>>>>>>>>>>>>>>>>> update mcu&fpga success"
		updateSign=UpdateSuccess
	fi

	if [ $upgradeStatus -ge 250 ] && [ $upgradeStatus -le 256 ]; then #升级失败
		log_info ">>>>>>>>>>>>>>>>>>>> update mcu&fpga fail, retry"
		bin_path="defpath"
		$upgrade_defpath $mcu_defpath $fpga_defpath $bin_path #再次重试一下升级
		upgradeStatus=$?
		
		if [ $upgradeStatus -eq 99  ]; then #升级成功
			log_info ">>>>>>>>>>>>>>>>>>>> retry update mcu&fpga success"
			updateSign=UpdateSuccess
		fi

		if [ $upgradeStatus -ge 250 ] && [ $upgradeStatus -le 256 ]; then #升级再次失败
			log_info ">>>>>>>>>>>>>>>>>>>> retry update mcu&fpga fail, update backup mcu&fpga"
			
			if [ -e $upgrade_backuppath ]; then
				#修改成备份位置的fpga和mcu
				bin_path="backup"
				chmod 0777 $upgradetools_backuppath/*
				if [ "$(getprop ro.product.device)" == "Hi3751V811" ];then
					busybox tar -xzvf $UpgraderConfig_backuppath -C $upgrade_backupdir #压缩tar -zcvf
				fi
				if [ "$(getprop ro.product.device)" == "expo" ] || [ "$(getprop ro.product.device)" == "tcl_mt5879_cn" ] || [ "$(getprop ro.product.device)" == "G08" ];then
					tar -xzvf $UpgraderConfig_backuppath -C $upgrade_backupdir #压缩tar -zcvf
				fi
				  
				cp $upgrade_backupdir/UpgradeConfig/config/* $UpgraderWork_path/UpgradeConfig/config
				$upgrade_backuppath $mcu_backuppath  $fpga_backuppath $bin_path
				log_info "start backup upgrade success"
			fi
			updateSign=UpdateFail
		fi
	fi
fi


