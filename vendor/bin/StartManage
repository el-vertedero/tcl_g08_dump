        # if [ -d /sdcard/Android ]; then
                # log_info "start /sdcard/Android start"
                # break
        # else
                # sleep 1
                # ii=$((ii+1))
        # fi

        # if [ $(ii) -gt 180 ]; then  #若data一直不存在超时则主动退出
                # log_info "start manage overtime"
                # break
        # fi
# }
# done

################################################################################################################################
#初始化阶段：
version="V1.1.0, 2024-04-26  Build"
log_info "version : $version "

# 辅助函数：打印当前 xserver 启动参数，便于排查
log_xserver_param() {
    enforce_log_param
    log_info "XSERVER_LOG_PARAM=${XSERVER_LOG_PARAM:-<empty>}"
}

# 辅助函数：同时检查 /mnt/media_rw/<id> 与 /storage/<id> 是否存在 nova.txt
check_nova_on_usb_mount() {
    local mount_point="$1"
    [ -z "$mount_point" ] && return 1

    # 直接检查当前挂载点
    if usb_has_nova_flag "$mount_point"; then
        return 0
    fi

    # 补充检查对应的 /storage/<id> 或 /mnt/media_rw/<id>
    local base_name
    base_name=$(basename "$mount_point")
    for alt in "/storage/$base_name" "/mnt/media_rw/$base_name"; do
        [ "$alt" = "$mount_point" ] && continue
        [ -d "$alt" ] || continue
        if usb_has_nova_flag "$alt"; then
            log_info "found nova.txt on alt path: $alt (origin: $mount_point)"
            return 0
        fi
    done
    return 1
}

# 辅助函数：在不增加额外等待的前提下做一次全量兜底扫描，找到可写且有 nova.txt 的U盘
full_scan_usb_with_nova_once() {
    local candidates=""
    candidates="$candidates /mnt/media_rw/*"
    candidates="$candidates /mnt/vendor/public"
    candidates="$candidates /storage/usbotg* /storage/USBOTG*"
    candidates="$candidates /storage/*"
    candidates="$candidates /mnt/usb* /mnt/USB*"
    candidates="$candidates /sdcard/UDISK"

    for dir in $candidates; do
        case "$dir" in
            *"/storage/emulated"*|*"/storage/self"*|*"/storage/USB"*)
                continue
                ;;
        esac
        [ -d "$dir" ] || continue

        # 可写性检查：以 is_mount_point_writable 为主，兼容偶发 mount 输出差异
        local writable="false"
        if [ "$(is_mount_point_writable "$dir")" = "true" ]; then
            writable="true"
        elif [ -w "$dir" ]; then
            writable="true"
        fi

        if [ "$writable" != "true" ]; then
            continue
        fi

        if check_nova_on_usb_mount "$dir"; then
            echo "$dir"
            return
        fi
    done
    echo ""
}

# 辅助函数：宽松扫描（不校验可写性），仅用于启动参数决策兜底
relaxed_scan_usb_with_nova_once() {
    local candidates=""
    candidates="$candidates /mnt/media_rw/*"
    candidates="$candidates /mnt/vendor/public"
    candidates="$candidates /storage/usbotg* /storage/USBOTG*"
    candidates="$candidates /storage/*"
    candidates="$candidates /mnt/usb* /mnt/USB*"
    candidates="$candidates /sdcard/UDISK"

    for dir in $candidates; do
        case "$dir" in
            *"/storage/emulated"*|*"/storage/self"*|*"/storage/USB"*)
                continue
                ;;
        esac
        [ -d "$dir" ] || continue
        if check_nova_on_usb_mount "$dir"; then
            echo "$dir"
            return
        fi
    done
    echo ""
}

# 辅助函数：根据当前环境强制校正 XSERVER_LOG_PARAM（无等待）
enforce_log_param() {
    # 工厂模式：始终不带 -LogFilename
    if is_factory_mode; then
        XSERVER_LOG_PARAM=""
        return
    fi

    # 优先使用已有 USB_MOUNT_RESULT
    if [ -n "$USB_MOUNT_RESULT" ] && check_nova_on_usb_mount "$USB_MOUNT_RESULT"; then
        XSERVER_LOG_PARAM=""
        return
    fi

    # 其次检查软链接指向
    local symlink_target=""
    symlink_target=$(readlink -f /data/vendor/nova/xserver/log 2>/dev/null || echo "")
    if [ -n "$symlink_target" ] && { echo "$symlink_target" | grep -qE "^/mnt/media_rw/|^/storage/"; }; then
        local mount_root="$symlink_target"
        [ -d "$mount_root" ] || mount_root=$(dirname "$mount_root")
        if ! check_nova_on_usb_mount "$mount_root"; then
            mount_root=$(dirname "$mount_root")
        fi
        if check_nova_on_usb_mount "$mount_root"; then
            USB_MOUNT_RESULT="$mount_root"
            XSERVER_LOG_PARAM=""
            return
        fi
    fi

    # 再尝试无等待的宽松扫描
    local quick_relaxed=""
    quick_relaxed=$(relaxed_scan_usb_with_nova_once)
    if [ -n "$quick_relaxed" ] && check_nova_on_usb_mount "$quick_relaxed"; then
        USB_MOUNT_RESULT="$quick_relaxed"
        XSERVER_LOG_PARAM=""
        return
    fi

    # 都没有，则按属性决定
    if should_enable_tmp_log_user_mode; then
        XSERVER_LOG_PARAM=""
    else
        XSERVER_LOG_PARAM=""
    fi
}

# 辅助函数：根据当前软链接指向快速判断是否已选中“U盘+nova.txt”
update_usb_flag_from_symlink() {
    local symlink_target=""
    symlink_target=$(readlink -f /data/vendor/nova/xserver/log 2>/dev/null || echo "")
    if [ -n "$symlink_target" ] && { echo "$symlink_target" | grep -qE "^/mnt/media_rw/|^/storage/"; }; then
        local mount_root="$symlink_target"
        [ -d "$mount_root" ] || mount_root=$(dirname "$mount_root")
        if ! check_nova_on_usb_mount "$mount_root"; then
            mount_root=$(dirname "$mount_root")
        fi
        if check_nova_on_usb_mount "$mount_root"; then
            USB_MOUNT_RESULT="$mount_root"
            usb_nova_found=1
            log_info "user mode: symlink confirms USB with nova.txt ($mount_root)"
        fi
    fi
}
rm -f /data/vendor/nova/xserver/log
#删除软连接
#设置xserver log目录的函数
setup_xserver_log() {
    log_info "setup xserver log directory"
    
    # 使用统一决策逻辑确定目标路径
    local target_path=""
    
    # U盘检测等待机制：尝试3次，每次间隔1秒（总共3秒）
    local usb_mount=""
    local retry_count=0
    local max_retries=3
    
    log_info "waiting for USB mount point (max ${max_retries}s)..."
    while [ $retry_count -lt $max_retries ]; do
        usb_mount=$(find_writable_usb_mount)
        if [ -n "$usb_mount" ]; then
            log_info "USB mount point found after ${retry_count}s: $usb_mount"
            break
        fi
        retry_count=$((retry_count + 1))
        if [ $retry_count -lt $max_retries ]; then
            log_info "USB not found, waiting... (retry $retry_count/$max_retries)"
            sleep 1
        fi
    done
    
    if [ -z "$usb_mount" ]; then
        log_info "no USB mount point found after ${max_retries}s"
    fi
    
    # 保存U盘扫描结果到全局变量，供后续使用
    USB_MOUNT_RESULT="$usb_mount"
    
    # 判断工厂模式/用户模式（复用 NovaLog 中的函数）
    if is_factory_mode; then
        # ========== 工厂模式分支 ==========
        log_info "factory mode detected"
        # 使用已扫描的U盘结果
        if [ -n "$usb_mount" ]; then
            # 有U盘：使用U盘路径
            target_path="$usb_mount/xserver_log"
            log_info "factory mode: using USB path: $target_path"
        else
            # 无U盘：使用 /tmp 路径
            target_path="/tmp/xserver_log"
            log_info "factory mode: no USB found, using tmp path: $target_path"
        fi
    else
        # ========== 用户模式分支 ==========
        log_info "user mode detected"
        # 使用已扫描的U盘结果（不再重新扫描）
        if [ -n "$usb_mount" ] && check_nova_on_usb_mount "$usb_mount"; then
            # 有U盘 + nova.txt：使用U盘路径
            target_path="$usb_mount/xserver_log"
            log_info "user mode: USB with nova.txt found, using USB path: $target_path"
            # 刷新 NovaLog 日志路径到 U 盘
            if command -v refresh_log_file_path >/dev/null 2>&1; then
                refresh_log_file_path >/dev/null 2>&1
                log_info "refreshed NovaLog path: ${LOG_FILE:-<empty>}"
            fi
        else
            # 兜底：再做一次无等待的全量扫描，防止挂载路径差异或短暂延迟
            local usb_mount_fallback=""
            usb_mount_fallback=$(full_scan_usb_with_nova_once)
            if [ -n "$usb_mount_fallback" ]; then
                USB_MOUNT_RESULT="$usb_mount_fallback"
                target_path="$usb_mount_fallback/xserver_log"
                log_info "user mode: fallback full scan found USB with nova.txt, using USB path: $target_path"
                # 刷新 NovaLog 日志路径到 U 盘
                if command -v refresh_log_file_path >/dev/null 2>&1; then
                    refresh_log_file_path >/dev/null 2>&1
                    log_info "refreshed NovaLog path: ${LOG_FILE:-<empty>}"
                fi
            else
                # 未找到 nova.txt，则视为无U盘
                USB_MOUNT_RESULT=""
            # 无U盘或无nova.txt：检查 persist.sys.normallog
            if should_enable_tmp_log_user_mode; then
                # persist.sys.normallog == true：允许写 /tmp
                target_path="/tmp/xserver_log"
                log_info "user mode: persist.sys.normallog=true, using tmp path: $target_path"
            else
                # persist.sys.normallog != true：不写日志（target_path 为空）
                target_path=""
                log_info "user mode: logging disabled (no USB+nova.txt, persist.sys.normallog!=true)"
            fi
            fi
        fi
    fi
    
    # 如果 target_path 为空（用户模式禁止日志），删除软链接并返回
    if [ -z "$target_path" ]; then
        log_info "user mode: logging disabled (persist.sys.normallog=false)"
        # 删除软链接（如果存在）
        if [ -L /data/vendor/nova/xserver/log ] || [ -e /data/vendor/nova/xserver/log ]; then
            log_info "removing existing symlink/directory: /data/vendor/nova/xserver/log"
            rm -rf /data/vendor/nova/xserver/log
            if [ $? -eq 0 ]; then
                log_info "successfully removed symlink/directory"
            else
                log_warn "failed to remove symlink/directory"
            fi
        fi
        return 0
    fi
    
    # 3. 检查xserver进程是否正在运行
    xserver_pid=$(pgrep NeoController)
    xserver_running=0
    if [ -n "$xserver_pid" ]; then
        xserver_running=1
        log_info "xserver process is running (PID: $xserver_pid)"
    else
        log_info "xserver process is not running"
    fi
    
    # 4. 检查现有的软链接是否指向正确的路径
    need_create_link=1
    if [ -L /data/vendor/nova/xserver/log ]; then
        current_link=$(readlink -f /data/vendor/nova/xserver/log 2>/dev/null || readlink /data/vendor/nova/xserver/log 2>/dev/null || echo "")
        if [ -n "$current_link" ]; then
            target_abs_path=$(readlink -f "$target_path" 2>/dev/null || echo "$target_path")
            
            # 如果软链接已存在且指向正确路径，跳过删除重建
            if [ "$current_link" = "$target_abs_path" ] || [ "$current_link" = "$target_path" ]; then
                log_info "symlink already exists and points to correct path: $target_path"
                # 确保目标目录存在
                mkdir -p "$target_path" 2>/dev/null
                need_create_link=0
            else
                log_info "symlink exists but points to different path: $current_link, need to update"
                # 如果xserver正在运行，不能删除log目录，需要先kill进程
                if [ $xserver_running -eq 1 ]; then
                    log_warn "xserver is running, cannot change log path. Please kill xserver first"
                    log_warn "current log path: $current_link, target path: $target_path"
                    # xserver运行中，不删除log目录，也不创建新链接
                    need_create_link=0
                else
                    rm -f /data/vendor/nova/xserver/log
                    need_create_link=1
                fi
            fi
        else
            log_warn "failed to read symlink, will recreate"
            rm -f /data/vendor/nova/xserver/log
            need_create_link=1
        fi
    elif [ -e /data/vendor/nova/xserver/log ]; then
        # 如果是目录或其他类型，需要删除
        # 即使xserver正在运行，也要删除目录并创建软链接（因为正常状态应该是软链接）
        if [ -d /data/vendor/nova/xserver/log ]; then
            if [ $xserver_running -eq 1 ]; then
                log_warn "xserver is running, but log is a directory (should be symlink), removing it anyway"
            fi
            log_info "removed existing log directory"
            rm -rf /data/vendor/nova/xserver/log
            need_create_link=1
        else
            # 如果是其他类型文件，也需要删除
            if [ $xserver_running -eq 1 ]; then
                log_warn "xserver is running, but log is not a symlink, removing it anyway"
            fi
            log_info "removed existing log file/link"
            rm -rf /data/vendor/nova/xserver/log
            need_create_link=1
        fi
    fi
    
    # 5. 创建目标目录
    mkdir -p "$target_path"
    if [ $? -eq 0 ]; then
        log_info "created target log directory: $target_path"
    else
        log_warn "failed to create target log directory: $target_path"
        # 如果创建失败，尝试使用/tmp作为最后备选
        if [ "$target_path" != "/tmp/xserver_log" ]; then
            log_info "fallback to /tmp/xserver_log"
            target_path="/tmp/xserver_log"
            mkdir -p "$target_path"
            if [ $? -ne 0 ]; then
                log_warn "failed to create /tmp/xserver_log"
                # 目标目录创建失败，无法创建软链接，但继续执行
                log_warn "cannot create symlink because target directory creation failed"
            fi
        else
            log_warn "target path creation failed, cannot create symlink"
        fi
    fi
    
    # 验证目标目录是否存在且可写（每次启动前都检查）
    # 如果U盘路径不可用，回退到/tmp
    if [ ! -d "$target_path" ] || [ ! -w "$target_path" ]; then
        log_warn "target directory does not exist or is not writable: $target_path"
        # 如果当前路径不是/tmp，回退到/tmp
        if [ "$target_path" != "/tmp/xserver_log" ]; then
            log_info "fallback to /tmp/xserver_log"
            target_path="/tmp/xserver_log"
            mkdir -p "$target_path"
            if [ $? -ne 0 ] || [ ! -w "$target_path" ]; then
                log_warn "cannot create or write to /tmp/xserver_log, will skip symlink creation"
            fi
        else
            log_warn "cannot use target path, will skip symlink creation"
        fi
    fi
    
    # 6. 创建软链接（如果需要创建）
    if [ $need_create_link -eq 1 ]; then
        # 再次验证目标目录是否可用（防止在创建软链接前u盘被拔掉）
        if [ -d "$target_path" ] && [ -w "$target_path" ]; then
            if [ ! -e /data/vendor/nova/xserver/log ]; then
                ln -s "$target_path" /data/vendor/nova/xserver/log
                if [ $? -eq 0 ]; then
                    log_info "created symlink: /data/vendor/nova/xserver/log -> $target_path"
                else
                    log_warn "failed to create symlink, continuing anyway"
                fi
            else
                log_warn "cannot create symlink, /data/vendor/nova/xserver/log already exists (not a symlink)"
            fi
        else
            log_warn "target directory is not available, skipping symlink creation"
        fi
    else
        log_info "symlink already exists or xserver is running, skipping creation"
    fi
}

#初始化阶段：设置xserver log目录
#setup_xserver_log

# 参数决策起始日志，便于定位
pmode_value=$(getprop odm.tcl.factory.pmode 2>/dev/null)
log_info "param decision begin: pmode=${pmode_value:-<unset>}, USB_MOUNT_RESULT=${USB_MOUNT_RESULT:-<empty>}"

#根据统一决策逻辑设置 xserver 启动参数（U盘优先）
if is_factory_mode; then
    # 工厂模式：使用默认配置（通过软链接控制）
    XSERVER_LOG_PARAM=""
    log_info "factory mode: xserver will use default log path (via symlink)"
else
    # 用户模式：U盘+nova.txt 优先级最高
    log_info "user mode param decision: USB_MOUNT_RESULT=${USB_MOUNT_RESULT:-<empty>}"
    usb_nova_found=0
    # 先用已有软链接快速判定（处理 setup_xserver_log 已落在 U 盘但变量丢失的情况）
    symlink_target=$(readlink -f /data/vendor/nova/xserver/log 2>/dev/null || echo "")
    if [ -n "$symlink_target" ] && { echo "$symlink_target" | grep -qE "^/mnt/media_rw/|^/storage/"; }; then
        mount_root=$(dirname "$symlink_target")
        if ! check_nova_on_usb_mount "$mount_root"; then
            mount_root=$(dirname "$mount_root")
        fi
        if check_nova_on_usb_mount "$mount_root"; then
            USB_MOUNT_RESULT="$mount_root"
            usb_nova_found=1
            XSERVER_LOG_PARAM=""
            log_info "user mode: symlink confirms USB with nova.txt ($mount_root), keep USB log path"
        fi
    fi

    if [ $usb_nova_found -eq 0 ]; then
        if [ -n "$USB_MOUNT_RESULT" ] && check_nova_on_usb_mount "$USB_MOUNT_RESULT"; then
            usb_nova_found=1
            XSERVER_LOG_PARAM=""
            log_info "user mode: USB with nova.txt found, xserver will use USB log path (via symlink)"
        else
            usb_mount_fallback=$(full_scan_usb_with_nova_once)
            if [ -n "$usb_mount_fallback" ] && check_nova_on_usb_mount "$usb_mount_fallback"; then
                USB_MOUNT_RESULT="$usb_mount_fallback"
                usb_nova_found=1
                XSERVER_LOG_PARAM=""
                log_info "user mode: fallback full scan found USB with nova.txt, xserver will use USB log path (via symlink)"
            else
                usb_mount_relaxed=$(relaxed_scan_usb_with_nova_once)
                if [ -n "$usb_mount_relaxed" ] && check_nova_on_usb_mount "$usb_mount_relaxed"; then
                    USB_MOUNT_RESULT="$usb_mount_relaxed"
                    usb_nova_found=1
                    XSERVER_LOG_PARAM=""
                    log_info "user mode: relaxed scan found USB with nova.txt, xserver will use USB log path (via symlink)"
                fi
            fi
        fi
    fi

    # 无 U盘或无 nova.txt：检查 persist.sys.normallog
    if [ $usb_nova_found -eq 1 ]; then
        log_info "user mode: USB+nova.txt branch chosen, skip persist.sys.normallog"
    else
        if should_enable_tmp_log_user_mode; then
            XSERVER_LOG_PARAM=""
            log_info "user mode: persist.sys.normallog=true, xserver will use /tmp log path (via symlink)"
        else
            XSERVER_LOG_PARAM=""
            log_info "user mode: persist.sys.normallog=false, xserver will use log path: /qcx/test"
        fi
    fi
fi

# 最终兜底：如果仍决定使用 -LogFilename，再尝试一次宽松扫描避免错判
if [ "$XSERVER_LOG_PARAM" = "" ]; then
    late_usb_mount=$(relaxed_scan_usb_with_nova_once)
    if [ -n "$late_usb_mount" ] && check_nova_on_usb_mount "$late_usb_mount"; then
        USB_MOUNT_RESULT="$late_usb_mount"
        XSERVER_LOG_PARAM=""
        log_info "user mode: late promotion found USB with nova.txt, remove -LogFilename"
    fi
fi

# 最终保护：只要能找到任何含 nova.txt 的挂载点（含已有 symlink 指向），就强制去掉 -LogFilename
final_guard_clear_logfilename() {
    local candidates=""
    candidates="$candidates $USB_MOUNT_RESULT"
    candidates="$candidates $(readlink -f /data/vendor/nova/xserver/log 2>/dev/null || echo "")"
    candidates="$candidates /mnt/media_rw/*"
    candidates="$candidates /storage/*"

    for dir in $candidates; do
        [ -z "$dir" ] && continue
        # 先尝试当前目录，再尝试父目录（处理 xserver_log 子目录被传入的场景）
        local try_dir="$dir"
        for _ in 1 2; do
            [ -d "$try_dir" ] || { try_dir=$(dirname "$try_dir"); }
            [ -d "$try_dir" ] || continue
            if check_nova_on_usb_mount "$try_dir"; then
                XSERVER_LOG_PARAM=""
                log_info "user mode: final guard found nova.txt at $try_dir, remove -LogFilename"
                return
            fi
            # 尝试父目录一次
            try_dir=$(dirname "$try_dir")
        done
        # 回到下一候选
        if check_nova_on_usb_mount "$dir"; then
            XSERVER_LOG_PARAM=""
            log_info "user mode: final guard found nova.txt at $dir, remove -LogFilename"
            return
        fi
    done
}

if [ "$XSERVER_LOG_PARAM" = "" ]; then
    final_guard_clear_logfilename
fi

# 参数决策结束日志
log_info "param decision end: usb_nova_found=${usb_nova_found:-0}, XSERVER_LOG_PARAM=${XSERVER_LOG_PARAM:-<empty>}"

#备份总路径
