#!/vendor/bin/sh

######################################################脚本说明################################################################

#############################################################################################################################
#保证第一次启动和升级过程，data挂载比较慢，以其挂载情况作为判断依据
#setenforce 0 #配置selinux 不需要了
#sleep 15

# 在加载 NovaLog 前，尽量等待 U 盘挂载并存在 nova.txt（且可写），确保日志一开始就落到 U 盘
MAX_USB_WAIT=3
USB_FOUND=0
for _ in $(seq 0 $MAX_USB_WAIT); do
    for dir in /mnt/media_rw/* /storage/*; do
        [ -d "$dir" ] || continue
        case "$dir" in
            */emulated|*/self|*/USB*)
                continue
                ;;
        esac
        if [ -f "$dir/nova.txt" ]; then
            # 可写性简单校验
            if touch "$dir/.nova_usb_write_test" 2>/dev/null; then
                rm -f "$dir/.nova_usb_write_test" 2>/dev/null
                USB_FOUND=1
                break
            fi
        fi
    done
    [ $USB_FOUND -eq 1 ] && break
    sleep 1
done

if [ $USB_FOUND -eq 0 ]; then
    echo "[WARN] $(date '+%Y-%m-%d %H:%M:%S') USB+nova.txt not ready within ${MAX_USB_WAIT}s, may fall back to /tmp"
fi

source /vendor/bin/NovaLog

ii=0

while true
do
{
        if [ -d /data/data ]; then
                log_info "start manage start"
                break
        else
		
		
                sleep 1
                ii=$((ii+1))
        fi

        if [ $ii -gt 180 ]; then  #若data一直不存在超时则主动退出
                log_info "start manage overtime"
                break
        fi
}
done


# while true
# do
