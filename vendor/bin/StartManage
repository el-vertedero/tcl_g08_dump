#ls /sys/bus/usb/devices/2-3:1.0/net/
if [ "$(getprop ro.product.device)" == "tcl_mt5879_cn" ];then
	node_path="/sys/bus/usb/devices/2-3:1.0/net/eth1"  # 替换成你要检查的节点路径
	wait_time=1  # 设置循环检查的间隔时间，单位为秒

	# 循环检测节点是否存在
	while true; do
		# 如果已完成一次网络配置，直接退出此循环，避免重复打印

		if [ -e "$node_path" ]; then
			log_info "$node_path exist，continue..."
			# 在这里可以添加进一步的操作，如读取节点内容或执行其他命令
			break  # 可以选择在找到节点后退出循环
		else
			log_info "$node_path not exist，wait $wait_time sec..."
			sleep $wait_time
			node_path_copy="/sys/bus/usb/devices/2-3:1.0/net/nova_eth1"
			if [ -e "$node_path_copy" ]; then
				log_info "$node_path_copy exist，continue..."
				break
			fi
		fi
	done
fi
