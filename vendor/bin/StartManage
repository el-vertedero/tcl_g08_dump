###########################################################################################################################################
#进入第三阶段，Xserver保活流程

#Xserver保活的查询周期，单位s， 如果是 0，则代表关闭保活机制	 		   
cycle=60

if [ $cycle -eq 0 ]; then
	log_info "close xserver guard"
fi

# 仅在网卡配置完成后，首轮杀 1 次 NeoController，后续正常守护（STR 掉线后可再次触发）
KILLED_ONCE=0
# 仅在经历“掉线→重配→恢复”后才允许杀一次
NET_WAS_BAD=0

# 定义一个函数，用于执行需要每 5 秒执行配置网络的命令，应对tcL的str快速开机，会down掉eth1
command_eth1_5s() {
    while true; do
        # 在这里写入需要每 5 秒执行一次的命令
		ETH_OK=0
		while true; do
		if [ "$(/vendor/bin/ip addr show nova_eth1 | awk '/inet / {print $2}' | cut -d'/' -f1)" != "240.1.1.100" ];then
            # STR 可能导致网卡掉线，重配前重置“一次性杀进程”标志
            KILLED_ONCE=0
            NET_WAS_BAD=1
            log_info "config eth1"

          	ifconfig eth1 down
			/vendor/bin/ip link set eth1 name nova_eth1
			log_info "/vendor/bin/ip link set eth1 name nova_eth1"
            # 设置地址使用 replace，保持幂等
            /vendor/bin/ip -4 addr add 240.1.1.100/16 dev nova_eth1
            log_info "ip -4 addr add 240.1.1.100/16 dev nova_eth1"

            ifconfig nova_eth1 mtu 9000
            log_info "ifconfig nova_eth1 mtu 9000"

            ifconfig nova_eth1 up
            log_info "loop config eth1 already success"
            sleep 3
		
            log_info "sleep 3"
            if [ "$(getprop ro.product.device)" == "G08" ];then
                log_info "config ip rule"
                sleep 1
                /vendor/bin/ip rule del pref 11000
                /vendor/bin/ip rule del pref 16000
                /vendor/bin/ip rule del pref 17000
                /vendor/bin/ip rule del pref 18000
                /vendor/bin/ip rule del pref 19000
                /vendor/bin/ip rule del pref 20000
                sleep 1
                /vendor/bin/ip rule add from all fwmark 0x0/0x10000 lookup legacy_system pref 15000
                /vendor/bin/ip rule add from all fwmark 0x0/0x10000 lookup legacy_network pref 16000
                /vendor/bin/ip rule add from all fwmark 0x0/0x10000 lookup local_network pref 17000
                /vendor/bin/ip rule add from all lookup main pref 19000
                /vendor/bin/ip rule add iif lo oif dummy0 uidrange 0-0 lookup dummy0 pref 10500
                /vendor/bin/ip rule add from all fwmark 0x10063/0x1ffff iif lo lookup local_network pref 13000
                /vendor/bin/ip rule add iif lo oif dummy0 lookup dummy0 pref 14000

                log_info "config ip rule success"
            fi
		else
			log_info "eth1 already have111111"
			# sleep 1
			ETH_OK=1
			break
		fi
			done
			#/system/bin/tcpdump -i nova_eth1 -xxx -w /sdcard/xserver.pcap  &
            #在此处配网之后再加入将xserver进程杀死的逻辑，就是为了执行配网之后再启动xserver时序
            # 获取名为 NeoController 的进程的 PID
            pid=$(pgrep NeoController)
            log_info "pid: $pid"
            # 检查是否成功获取到 PID
            if [ -z "$pid" ]; then   #NeoController未起来
                log_info "start NeoController again"

                mkdir -p $XserverUserdata_path/controller
                mkdir -p $XserverUserdata_path/controller/usrconfig
                if [ -d "$SCREEN_DIR" ] && [ -f "$SCREEN_DIR/screenConfig.toml" ]; then
                    cp -r /userdata/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
                    log_info "return $?"
                    file_size=$(stat -c %s "$USRCONFIG")
                    log_info "file size is $file_size."
                    log_info "cp /userdata/usrconfig screen"
                else
                    cp -r /vendor/etc/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
                fi
                #log_info "return $?"
                log_info "screenconfig tar success1111"
                file_size=$(stat -c %s "$USRCONFIG")
                log_info "file size is $file_size."

                # setup_xserver_log
                # log_xserver_param
                $xserver_defpath -UserdataPath="$XserverUserdata_path" -OemPath="$XserverWork_path" -FPGAIface=nova_eth1 $XSERVER_LOG_PARAM &
                # 刚拉起一次，认为已完成首轮动作，避免后续立即杀进程；
                # 若后续掉线，前面的掉线检测会重置 KILLED_ONCE/NET_WAS_BAD。
                KILLED_ONCE=1
                NET_WAS_BAD=0
                set_neo_ready_prop 1
            else
                # 仅在网卡正常后首轮杀一次 Neo，且确认曾掉线过
                if [ "$ETH_OK" -eq 1 ] && [ "$KILLED_ONCE" -eq 0 ] && [ "$NET_WAS_BAD" -eq 1 ]; then
                    # 再次确认 IP 仍正常，避免误杀
                    if [ "$(/vendor/bin/ip addr show nova_eth1 | awk '/inet / {print $2}' | cut -d'/' -f1)" = "240.1.1.100" ]; then
                        log_info "kill -9 Neo (one-shot after eth ok)"
                        kill -9 $pid
                        if [ $? -eq 0 ]; then
                    #log_info "kill NeoController (PID: $pid)。"
                    mkdir -p $XserverUserdata_path/controller
                    mkdir -p $XserverUserdata_path/controller/usrconfig
                    if [ -d "$SCREEN_DIR" ] && [ -f "$SCREEN_DIR/screenConfig.toml" ]; then
                        cp -r /userdata/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
                        log_info "return $?"
                        file_size=$(stat -c %s "$USRCONFIG")
                        log_info "file size is $file_size."
                        log_info "cp /userdata/usrconfig screen"
                    else
                        cp -r /vendor/etc/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
                    fi
                    #log_info "return $?"
                    log_info "screenconfig tar success22222"
                    file_size=$(stat -c %s "$USRCONFIG")
                    log_info "file size is $file_size."
					#/system/bin/tcpdump -i nova_eth1 -xxx -w /sdcard/xserver.pcap &
                    # setup_xserver_log
                    # log_xserver_param
                    $xserver_defpath -UserdataPath="$XserverUserdata_path" -OemPath="$XserverWork_path" -FPGAIface=nova_eth1 $XSERVER_LOG_PARAM &
                    ps -ef | grep NeoController | grep -v grep
                    if [ $? -eq 0 ]; then #正常运行
                        
                        log_info "Xserver after kill run is normal"
                        KILLED_ONCE=1
                        NET_WAS_BAD=0
						set_neo_ready_prop 1
                    else

                        mkdir -p $XserverUserdata_path/controller
                        mkdir -p $XserverUserdata_path/controller/usrconfig
                        if [ -d "$SCREEN_DIR" ] && [ -f "$SCREEN_DIR/screenConfig.toml" ]; then
                            cp -r /userdata/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
                            log_info "return $?"
                            file_size=$(stat -c %s "$USRCONFIG")
                            log_info "file size is $file_size."
                            log_info "cp /userdata/usrconfig screen"
                        else
                            cp -r /vendor/etc/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
                        fi
                        #log_info "return $?"
                        log_info "screenconfig tar success444444"
						#/system/bin/tcpdump -i nova_eth1 -xxx -w /sdcard/xserver.pcap &
                        file_size=$(stat -c %s "$USRCONFIG")
                        log_info "file size is $file_size."
                        # setup_xserver_log
                        # log_xserver_param
                        $xserver_defpath -UserdataPath="$XserverUserdata_path" -OemPath="$XserverWork_path" -FPGAIface=nova_eth1 $XSERVER_LOG_PARAM &
                        set_neo_ready_prop 1
                    fi
                fi
                    else
                        log_info "skip kill: ip check failed"
                    fi
                else
                    log_info "not kill NeoController (PID: $pid)。"
                fi
            fi
	
		if [ $cycle -eq 0 ]; then
			sleep 300
		else
			#sleep $cycle
			ps -ef | grep NeoController | grep -v grep
			if [ $? -eq 0 ]; then #正常运行
				log_info "Xserver run is normal"
			
			else #进程不存在了
				if [ $XserverSign = "defpath" ]; then
					mkdir -p $XserverUserdata_path/controller
					mkdir -p $XserverUserdata_path/controller/usrconfig
					if [ -d "$SCREEN_DIR" ] && [ -f "$SCREEN_DIR/screenConfig.toml" ]; then
						cp -r /userdata/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
						log_info "return $?"
						file_size=$(stat -c %s "$USRCONFIG")
						log_info "file size is $file_size."
						log_info "cp /userdata/usrconfig screen"
					else
						cp -r /vendor/etc/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
					fi
					#log_info "return $?"
					log_info "screenconfig tar success6666666"
					file_size=$(stat -c %s "$USRCONFIG")
					log_info "file size is $file_size."
				#/system/bin/tcpdump -i nova_eth1 -xxx -w /sdcard/xserver.pcap &
				log_warn "start system xserver"
				# setup_xserver_log
				# log_xserver_param
				$xserver_defpath -UserdataPath="$XserverUserdata_path" -OemPath="$XserverWork_path" -FPGAIface=nova_eth1 $XSERVER_LOG_PARAM &
			else
					mkdir -p $XserverUserdata_path/controller
					mkdir -p $XserverUserdata_path/controller/usrconfig
					if [ -d "$SCREEN_DIR" ] && [ -f "$SCREEN_DIR/screenConfig.toml" ]; then
						cp -r /userdata/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
						log_info "return $?"
						file_size=$(stat -c %s "$USRCONFIG")
						log_info "file size is $file_size."
						log_info "cp /userdata/usrconfig screen"
					else
						cp -r /vendor/etc/usrconfig/* /data/vendor/nova/xserver/controller/usrconfig/
					fi
					#log_info "return $?"
					log_info "screenconfig tar success777777"
					file_size=$(stat -c %s "$USRCONFIG")
					log_info "file size is $file_size."
					
				log_warn "start backup xserver"
				#/system/bin/tcpdump -i nova_eth1 -xxx -w /sdcard/xserver.pcap &
				export LD_LIBRARY_PATH=$libxserver_backuppath:${LD_LIBRARY_PATH}
				# setup_xserver_log
				# log_xserver_param
				$xserver_backuppath -UserdataPath="$XserverUserdata_path" -OemPath="$XserverWork_path" -FPGAIface=nova_eth1 $XSERVER_LOG_PARAM &
			fi
			fi
		fi
		log_info "eth1 already have"
		sleep 3
		file_size=$(stat -c %s "$USRCONFIG")
		log_info "file size is $file_size."
    done
}

#保活60s，原来配置保留
command_alive_60s() {
	while true
	do
	{
		
		 sleep 3
	}
	done
}

# 循环执行两个命令

# 主循环：监控后台任务状态，如果进程退出则重启
# 注意：这里监控的是后台任务的PID，如果任务正常退出会被重启
while true; do
        command_eth1_5s &
       
        command_alive_60s &
       
		wait
done



