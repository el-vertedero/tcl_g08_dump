# }
# #错误日志
# log_err(){
#   content="[ERROR] $(date '+%Y-%m-%d %H:%M:%S') $@"
#   [ $LOG_LEVEL -le 4  ] && echo -e "$content" >> $LOG_FILE && echo -e "$content" 
