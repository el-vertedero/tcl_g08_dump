# LOG_LEVEL=2
#
# #如果日志大小超过上限，则保存旧日志，重新生成日志文件
# FSIZE=50000000   
#
# #日志文件
# LOG_PATH=/data/vendor/nova/NovaLog
# LOG_FILE=$LOG_PATH/upgrade.log
#
# #判断备份目录是否存在
# if [ ! -d $LOG_PATH ]; then
#   mkdir -p $LOG_PATH
#   touch $LOG_FILE
# fi
#
# #判断文件是否存在
# if [ ! -f $LOG_FILE ]; then
#   touch $LOG_FILE
# fi
#
# #判断文件大小
# CURSIZE=$(cat $LOG_FILE | wc -c)
#
# if [ $FSIZE -lt $CURSIZE ]; then
#   rm $LOG_FILE
#   touch $LOG_FILE
# fi 
#
# #调试日志
# log_debug(){
#   content="[DEBUG] $(date '+%Y-%m-%d %H:%M:%S') $@"
#   [ $LOG_LEVEL -le 1  ] && echo -e "$content" >> $LOG_FILE && echo -e "$content" 
# }
# #信息日志
# log_info(){
#   content="[INFO] $(date '+%Y-%m-%d %H:%M:%S') $@"
#   [ $LOG_LEVEL -le 2  ] && echo -e $content >> $LOG_FILE && echo -e "$content" 
# }
# #警告日志
# log_warn(){
#   content="[WARN] $(date '+%Y-%m-%d %H:%M:%S') $@"
